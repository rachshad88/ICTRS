{
  "name": "itrs-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node -r dotenv/config src/index.ts",
    "seed": "ts-node seed.ts",
    "clean": "if exist dist rmdir /s /q dist",
    "restart": "node -e \"require('child_process').exec('netstat -ano | findstr :3000',(e,o)=>{const p=o.split('\\n').find(l=>l.includes('LISTENING'));if(p){const pid=p.trim().split(/ +/).pop();try{process.kill(+pid)}catch{}}})\" & node dist/index.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^8.1.0",
    "mongodb": "^5.9.2",
    "multer": "^2.4.0",
    "redis": "^5.11.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
