# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_DB=itrs

# Redis Configuration (optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Session Configuration (REQUIRED - generate a random string at least 32 chars)
SESSION_SECRET=change-this-to-a-random-secret-at-least-32-characters-long

# Server Configuration
PORT=3000
NODE_ENV=development


# Timezone for day filters and displayed times (default Asia/Manila)
# APP_TIMEZONE=Asia/Manila

# Other websites allowed to call the API from a browser, comma-separated (default: the CSF rating site)
# CORS_ORIGINS=http://192.168.110.19

# Network interface the backend listens on. Use 127.0.0.1 once nothing outside this machine calls port 3000.
# BIND_HOST=0.0.0.0
